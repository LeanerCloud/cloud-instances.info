# Cloud Provider Credentials (Required for scrapers)
# =================================================

# AWS - for EC2, RDS, ElastiCache, OpenSearch, Redshift pricing
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure - Service Principal for VM pricing
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# GCP - API key for Compute Engine pricing
GCP_API_KEY=


# CloudFlare Deployment (Required for deployment)
# ================================================

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Production
PRODUCTION_HOSTNAME=cloud-instances.info
PRODUCTION_CF_BUCKET=
PRODUCTION_CF_AWS_ACCESS_KEY_ID=
PRODUCTION_CF_AWS_SECRET_ACCESS_KEY=
PRODUCTION_CF_NAMESPACE=
PRODUCTION_CF_ZONE_ID=

# Staging
STAGING_HOSTNAME=staging-cloud-instances.uk
STAGING_CF_BUCKET=
STAGING_CF_AWS_ACCESS_KEY_ID=
STAGING_CF_AWS_SECRET_ACCESS_KEY=
STAGING_CF_NAMESPACE=
STAGING_CF_ZONE_ID=
DEPLOYMENT_CF_ACCOUNT_ID=

# PR Environments (for ephemeral environments)
TF_STATE_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PR_CF_NAMESPACE=
CLOUDFLARE_ZONE_ID=


# Optional
# ========

# Slack notifications
SLACK_WEBHOOK_URL=
SCRAPER_SLACK_WEBHOOK_URL=

# Google Tag Manager (analytics)
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=

# Umami Analytics (privacy-friendly alternative)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://stats.leanercloud.com/data.js

# Error monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Hide sponsor banner
# NEXT_PUBLIC_REMOVE_ADVERTS=1
