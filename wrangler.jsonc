{
    "name": "cloud-instances-worker",
    "compatibility_date": "2025-05-12",
    "main": "worker.js",
    // Production R2 bucket + KV namespace (this fork's Cloudflare account).
    // Create these in Cloudflare and fill in the KV namespace id below.
    "r2_buckets": [
        {
            "bucket_name": "cloud-instances-assets-production",
            "binding": "ASSETS_BUCKET",
        },
    ],
    "kv_namespaces": [
        {
            "binding": "ASSETS_KV",
            "id": "a461ea5343054b13af96d12af4a1972a",
        },
    ],
    "env": {
        "staging": {
            "name": "cloud-instances-worker-staging",
            "r2_buckets": [
                {
                    "bucket_name": "cloud-instances-assets-staging",
                    "binding": "ASSETS_BUCKET",
                },
            ],
            "kv_namespaces": [
                {
                    "binding": "ASSETS_KV",
                    "id": "11ab2e7c19f2474cbad30bacebacc71a",
                },
            ],
            "routes": [
                {
                    "pattern": "staging-cloud-instances.uk",
                    "custom_domain": true,
                },
            ],
        },
        "production": {
            "name": "cloud-instances-worker-production",
            // Named environments do NOT inherit top-level bindings, so the R2
            // bucket + KV namespace must be redeclared here (matching staging),
            // otherwise the worker has no ASSETS_BUCKET/ASSETS_KV and throws 1101.
            "r2_buckets": [
                {
                    "bucket_name": "cloud-instances-assets-production",
                    "binding": "ASSETS_BUCKET",
                },
            ],
            "kv_namespaces": [
                {
                    "binding": "ASSETS_KV",
                    "id": "a461ea5343054b13af96d12af4a1972a",
                },
            ],
            "routes": [
                {
                    "pattern": "cloud-instances.info",
                    "custom_domain": true,
                },
            ],
        },
    },
}
